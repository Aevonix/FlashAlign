+// SPDX-FileCopyrightText: 2026 Aevonix Inc and the respective contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+#include "flashalign-ownership.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <cassert>
+#include <map>
+#include <memory>
+#include <new>
+#include <string>
+#include <vector>
+
+struct allocation_fault {
+    bool fail = false;
+};
+
+template <class T>
+struct fault_allocator {
+    using value_type = T;
+    allocation_fault * fault;
+    fault_allocator(allocation_fault * state = nullptr) : fault(state) {}
+    template <class U> fault_allocator(const fault_allocator<U> & other) : fault(other.fault) {}
+    T * allocate(size_t count) {
+        if (fault && fault->fail) {
+            fault->fail = false;
+            throw std::bad_alloc();
+        }
+        return std::allocator<T>{}.allocate(count);
+    }
+    void deallocate(T * ptr, size_t count) { std::allocator<T>{}.deallocate(ptr, count); }
+    template <class U> bool operator==(const fault_allocator<U> & other) const { return fault == other.fault; }
+    template <class U> bool operator!=(const fault_allocator<U> & other) const { return !(*this == other); }
+};
+
+struct tracked {
+    int & live;
+    explicit tracked(int & count) : live(count) { ++live; }
+    ~tracked() { --live; }
+};
+struct owned {
+    std::unique_ptr<tracked> ptr;
+};
+struct view {
+    tracked * ptr;
+};
+using owners_type = std::map<int, owned, std::less<int>, fault_allocator<std::pair<const int, owned>>>;
+using views_type = std::vector<view, fault_allocator<view>>;
+using retired_type = std::map<int, std::string, std::less<int>, fault_allocator<std::pair<const int, std::string>>>;
+
+static void publication_failures() {
+    for (int stage = 0; stage < 3; ++stage) {
+        int live = 0;
+        allocation_fault map_fault, vector_fault;
+        owners_type owners{std::less<int>{}, {&map_fault}};
+        views_type views{{&vector_fault}};
+        views.reserve(1);
+        flashalign::publish_generation(owners, views, 1, owned{std::make_unique<tracked>(live)},
+            [](const owned & item) { return view{item.ptr.get()}; });
+        tracked * const original = views[0].ptr;
+        map_fault.fail = stage == 0;
+        vector_fault.fail = stage == 1;
+        bool threw = false;
+        try {
+            flashalign::publish_generation(owners, views, 2, owned{std::make_unique<tracked>(live)},
+                [stage](const owned & item) {
+                    if (stage == 2) throw std::runtime_error("view construction failed");
+                    return view{item.ptr.get()};
+                });
+        } catch (const std::exception &) {
+            threw = true;
+        }
+        assert(threw && live == 1 && owners.size() == 1 && views.size() == 1);
+        assert(owners.count(2) == 0 && views[0].ptr == original && owners.at(1).ptr.get() == original);
+        flashalign::publish_generation(owners, views, 2, owned{std::make_unique<tracked>(live)},
+            [](const owned & item) { return view{item.ptr.get()}; });
+        assert(live == 2 && views[1].ptr == owners.at(2).ptr.get() && views[0].ptr == original);
+        owners.clear();
+        assert(live == 0);
+    }
+}
+
+static void retirement_failures() {
+    int live = 0;
+    allocation_fault map_fault, vector_fault, retired_fault;
+    owners_type owners{std::less<int>{}, {&map_fault}};
+    views_type views{{&vector_fault}};
+    retired_type retired{std::less<int>{}, {&retired_fault}};
+    flashalign::publish_generation(owners, views, 1, owned{std::make_unique<tracked>(live)},
+        [](const owned & item) { return view{item.ptr.get()}; });
+    tracked * const original = views[0].ptr;
+    bool committed = false;
+    const auto commit = [&]() noexcept {
+        views[0].ptr = nullptr;
+        owners.erase(1);
+        committed = true;
+    };
+    retired_fault.fail = true;
+    bool threw = false;
+    try {
+        flashalign::record_retirement(retired, 1, std::string("digest"), commit);
+    } catch (const std::bad_alloc &) {
+        threw = true;
+    }
+    assert(threw && !committed && live == 1 && owners.size() == 1 && retired.empty());
+    assert(views[0].ptr == original && owners.at(1).ptr.get() == original);
+    flashalign::record_retirement(retired, 1, std::string("digest"), commit);
+    assert(committed && live == 0 && owners.empty() && views[0].ptr == nullptr);
+    assert(retired.at(1) == "digest");
+    committed = false;
+    threw = false;
+    try {
+        flashalign::record_retirement(retired, 1, std::string("changed"), commit);
+    } catch (const std::runtime_error &) {
+        threw = true;
+    }
+    assert(threw && !committed && retired.at(1) == "digest");
+}
+
+int main() {
+    publication_failures();
+    retirement_failures();
+}
