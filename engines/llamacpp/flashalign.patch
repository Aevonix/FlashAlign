diff --git a/tests/test-flashalign-output.cpp b/tests/test-flashalign-output.cpp
new file mode 100644
index 000000000..ac22ea6fe
--- /dev/null
+++ b/tests/test-flashalign-output.cpp
@@ -0,0 +1,104 @@
+// SPDX-FileCopyrightText: 2026 Aevonix Inc and the respective contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+// Commercial licensing: contact@aevonix.com.
+#include "llama-adapter.h"
+#include "ggml-cpu.h"
+#include "common.h"
+#include "speculative.h"
+#include "server-task.h"
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+int main() {
+    llama_adapter_lora projection(nullptr), ordinary(nullptr);
+    projection.output_projection = true;
+    common_params params;
+    params.speculative.draft.mparams.path = "fixture";
+    params.lora_adapters.push_back({ "projection", 1.0f, "", "", &projection });
+    params.lora_adapters.push_back({ "ordinary", 1.0f, "", "", &ordinary });
+    const auto draft = common_base_params_to_speculative(params);
+    assert(draft.lora_adapters.size() == 1 && draft.lora_adapters[0].ptr == &ordinary);
+    // Every stored prefix retains its immutable adapter identity and exact strength.
+    server_prompt_cache cache(16, 4096);
+    server_prompt owner;
+    owner.tokens = server_tokens(llama_tokens{ 1, 2, 3 }, false);
+    owner.adapter_identity = { { uintptr_t(1), 1.0f } };
+    assert(cache.alloc(owner, 4, 0)->prompt.adapter_identity == owner.adapter_identity);
+    server_prompt stock;
+    stock.tokens = server_tokens(llama_tokens{ 1, 2, 3 }, false);
+    assert(cache.alloc(stock, 4, 0)->prompt.adapter_identity.empty());
+    server_prompt reduced = owner.clone();
+    reduced.adapter_identity = { { uintptr_t(1), 0.5f } };
+    assert(cache.alloc(reduced, 4, 0)->prompt.adapter_identity == reduced.adapter_identity);
+    assert(cache.states.size() == 3);
+    assert(owner.clone().adapter_identity == owner.adapter_identity);
+    server_prompt shifted = owner.clone();
+    shifted.replace_tokens(llama_tokens{ 1, 3 });
+    assert(shifted.adapter_identity == owner.adapter_identity);
+    assert(shifted.tokens.get_tokens() == (llama_tokens{ 1, 3 }));
+    assert(shifted.checkpoints.empty());
+    server_prompt_cache shifted_cache(16, 4096);
+    assert(shifted_cache.alloc(shifted, 4, 0)->prompt.adapter_identity == owner.adapter_identity);
+    server_prompt shifted_stock;
+    assert(shifted_cache.load(shifted_stock, shifted.tokens, nullptr, nullptr, 0));
+    assert(shifted_stock.tokens.size() == 0);
+    // No cache of another profile/strength may even try to restore into a context.
+    server_prompt_cache owner_only(16, 4096);
+    owner_only.alloc(owner, 4, 0);
+    server_prompt empty_stock;
+    assert(owner_only.load(empty_stock, stock.tokens, nullptr, nullptr, 0));
+    assert(empty_stock.tokens.size() == 0);
+    reduced.clear();
+    assert(reduced.adapter_identity.empty());
+
+    for (float bad : { 0.0f, -1.0f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN() }) {
+        assert(!llama_adapter_projection_scale_valid(bad));
+    }
+    assert(!llama_adapter_projection_scale_valid(std::numeric_limits<float>::max()));
+    const float maximum_site_scale = std::numeric_limits<float>::max()/2.0f;
+    assert(llama_adapter_projection_scale_valid(maximum_site_scale));
+    assert(std::isfinite(2.0f*maximum_site_scale));
+    assert(!llama_adapter_projection_scale_valid(std::nextafter(maximum_site_scale, std::numeric_limits<float>::infinity())));
+    for (float site_scale : { 0.5f, 1.0f, 2.997997f, 3.0f }) {
+        assert(llama_adapter_projection_scale_valid(site_scale));
+        for (float alpha : { 0.0f, 0.25f, 1.0f }) {
+        ggml_init_params params = { 1024*1024, nullptr, false };
+        ggml_context * ctx = ggml_init(params);
+        auto * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, 2);
+        auto * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2, 3);
+        auto * y = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, 4);
+        const float basis[] = { 1, 0, 0, 0, 1, 0 };
+        const float transpose[] = { -1, 0, 0, -1, 0, 0 };
+        for (int i = 0; i < 6; ++i) {
+            static_cast<float *>(a->data)[i] = basis[i];
+            static_cast<float *>(b->data)[i] = transpose[i];
+        }
+        for (int i = 0; i < 12; ++i) static_cast<float *>(y->data)[i] = float(i-3);
+        auto * result = llama_adapter_project_output(ctx, y, a, b, alpha * site_scale);
+        if (alpha == 0.0f) {
+            assert(result == y);
+            static_cast<float *>(y->data)[0] = std::numeric_limits<float>::quiet_NaN();
+            assert(std::isnan(static_cast<float *>(result->data)[0]));
+        } else {
+            auto * graph = ggml_new_graph(ctx);
+            ggml_build_forward_expand(graph, result);
+            assert(ggml_graph_compute_with_ctx(ctx, graph, 2) == GGML_STATUS_SUCCESS);
+            for (int token = 0; token < 4; ++token) {
+                for (int channel = 0; channel < 3; ++channel) {
+                    float expected = float(token*3+channel-3);
+                    if (channel < 2) expected *= 1-alpha*site_scale;
+                    assert(std::abs(static_cast<float *>(result->data)[token*3+channel]-expected) < 1e-6f);
+                }
+            }
+        }
+        ggml_free(ctx);
+    }
+    }
+    std::puts("native GGML projection: zero identity, non-unit site strengths and alpha interpolation passed");
+}
