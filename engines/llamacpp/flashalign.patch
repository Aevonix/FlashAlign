+static std::string flashalign_file_hash(const std::string & path) {
+    const auto status = std::filesystem::symlink_status(path);
+    if (!std::filesystem::is_regular_file(status) || std::filesystem::file_size(path) > 512ull*1024*1024) {
+        throw std::runtime_error("invalid profile file");
+    }
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) throw std::runtime_error("unreadable profile file");
+    sha256_t state;
+    sha256_init(&state);
+    char buffer[65536];
+    while (stream) {
+        stream.read(buffer, sizeof(buffer));
+        sha256_update(&state, reinterpret_cast<const unsigned char *>(buffer), stream.gcount());
+    }
+    if (!stream.eof()) throw std::runtime_error("profile read failed");
+    unsigned char digest[32];
+    sha256_final(&state, digest);
+    const char * hex = "0123456789abcdef";
+    std::string result;
+    for (auto byte : digest) { result += hex[byte >> 4]; result += hex[byte & 15]; }
+    return result;
+}
