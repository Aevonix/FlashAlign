+inline bool llama_adapter_projection_scale_valid(float scale) {
+    return std::isfinite(scale) && scale > 0.0f && scale <= std::numeric_limits<float>::max()/2.0f;
+}
+
+inline ggml_tensor * llama_adapter_project_output(ggml_context * ctx, ggml_tensor * output,
+        ggml_tensor * a, ggml_tensor * b, float scale) {
+    if (scale == 0.0f) {
+        return output;
+    }
+    ggml_tensor * delta = ggml_mul_mat(ctx, b, ggml_mul_mat(ctx, a, output));
+    return ggml_add(ctx, output, ggml_scale(ctx, delta, scale));
+}
