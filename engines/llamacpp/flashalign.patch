new file mode 100644
index 000000000..dce55fc1b
--- /dev/null
+++ b/common/flashalign-ownership.h
@@ -0,0 +1,37 @@
+// SPDX-FileCopyrightText: 2026 Aevonix Inc and the respective contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+#pragma once
+
+#include <stdexcept>
+#include <utility>
+
+namespace flashalign {
+
+// Publish borrowed pointers only after the owning map has accepted the object.
+template <class Owners, class Views, class Key, class Value, class MakeView>
+auto publish_generation(Owners & owners, Views & views, const Key & key, Value && value, MakeView make_view) {
+    auto inserted = owners.emplace(key, std::forward<Value>(value));
+    if (!inserted.second) {
+        throw std::runtime_error("generation already exists");
+    }
+    try {
+        views.push_back(make_view(inserted.first->second));
+    } catch (...) {
+        owners.erase(inserted.first);
+        throw;
+    }
+    return inserted.first;
+}
+
+// Allocate the tombstone before a nonthrowing commit releases live resources.
+template <class Retired, class Key, class Digest, class Commit>
+void record_retirement(Retired & retired, const Key & key, const Digest & digest, Commit commit) {
+    static_assert(noexcept(commit()), "retirement commit must not throw");
+    auto inserted = retired.emplace(key, digest);
+    if (!inserted.second && inserted.first->second != digest) {
+        throw std::runtime_error("retired generation digest changed");
+    }
+    commit();
+}
+
+} // namespace flashalign
